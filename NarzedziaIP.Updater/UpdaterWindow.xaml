<Window x:Class="NarzedziaIPUpdater.UpdaterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aktualizacja Narzędzia IP"
        Width="500"
        Height="320"
        MinWidth="460"
        MinHeight="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblHeading"
                   Grid.Row="0"
                   FontSize="15"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Text="Instalowanie aktualizacji..."/>

        <TextBlock x:Name="lblPhase"
                   Grid.Row="1"
                   Margin="0,6,0,0"
                   Text="Oczekiwanie na zamknięcie programu..."/>

        <ProgressBar x:Name="progress"
                     Grid.Row="2"
                     Height="18"
                     Margin="0,6,0,8"
                     Minimum="0"
                     Maximum="1000"
                     Value="0"/>

        <TextBox x:Name="txtLog"
                 Grid.Row="3"
                 FontFamily="Consolas"
                 FontSize="11"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="btnInstall"
                    Content="Pobierz i zainstaluj"
                    Width="170"
                    Height="30"
                    Margin="0,0,8,0"
                    Visibility="Collapsed"
                    Click="btnInstall_Click"/>
            <Button x:Name="btnClose"
                    Content="Zamknij"
                    Width="100"
                    Height="30"
                    IsEnabled="False"
                    Click="btnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
