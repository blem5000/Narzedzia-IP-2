<Window x:Class="NarzedziaIP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Narzedzia IP"
        Width="889"
        Height="500"
        MinWidth="700"
        MinHeight="450"
        FontFamily="Segoe UI"
        FontSize="14"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <TabControl x:Name="tabControl1">

            <!-- DHCP TAB -->
            <TabItem x:Name="tabDHCP" Header="Hostname do DHCP">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="500"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hostname input row -->
                    <Grid Grid.Row="0"
                          Grid.Column="0"
                          Margin="0,0,10,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Hostname:"
                                   Grid.Column="0"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBox x:Name="txtHostname"
                                 Grid.Column="1"
                                 Height="31"
                                 MinWidth="200"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,10,0"/>

                        <Button x:Name="btnSearchConnect"
                                Grid.Column="2"
                                Content="Wyszukaj i połącz"
                                Width="165"
                                Height="40"
                                Click="btnSearchConnect_Click"/>
                    </Grid>

                    <!-- DHCP search status / progress -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Vertical"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="txtStatus"
                                   Text=""
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>

                        <ProgressBar x:Name="progressSearch"
                                     Height="18"
                                     Width="160"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Buttons row -->
                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,20,0,20">

                        <!-- Sposob polaczenia (zapamietywany) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Sposób połączenia:"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <RadioButton x:Name="rbtnConnMSRA"
                                         Content="MSRA"
                                         Margin="0,0,15,0"
                                         VerticalAlignment="Center"
                                         Checked="rbtnConn_Checked"/>
                            <RadioButton x:Name="rbtnConnRDP"
                                         Content="RDP"
                                         Margin="0,0,15,0"
                                         VerticalAlignment="Center"
                                         Checked="rbtnConn_Checked"/>
                            <RadioButton x:Name="rbtnConnTactical"
                                         Content="TacticalRMM"
                                         VerticalAlignment="Center"
                                         Checked="rbtnConn_Checked"/>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">

                        <Button x:Name="btnSearch"
                                Content="Szukaj"
                                Width="92"
                                Height="40"
                                Margin="0,0,10,10"
                                Click="btnSearch_Click"/>

                        <Button x:Name="btnClear"
                                Content="Wyczyść"
                                Width="92"
                                Height="40"
                                Margin="0,0,10,10"
                                Click="btnClear_Click"/>

                        <Button x:Name="btnCopyIP"
                                Content="Kopiuj IP"
                                Width="92"
                                Height="40"
                                Margin="0,0,10,10"
                                Click="btnCopyIP_Click"/>

                        <Button x:Name="btnCopyMAC"
                                Content="Kopiuj MAC"
                                Width="105"
                                Height="40"
                                Margin="0,0,10,10"
                                Click="btnCopyMAC_Click"/>

                        <Button x:Name="btnConnect"
                                Content="Połącz"
                                Width="92"
                                Height="40"
                                Margin="0,0,10,10"
                                ToolTip="Połączenie z wybranym sposobem (MSRA albo RDP)"
                                Click="btnConnect_Click"/>

                        <Button x:Name="btnTactical"
                                Content="Tactical"
                                Width="92"
                                Height="40"
                                Margin="0,0,10,10"
                                ToolTip="Otwórz pulpit w TacticalRMM"
                                Click="btnTactical_Click"/>

                        <Button x:Name="btnShowInRmm"
                                Content="Pokaż w RMM"
                                Width="105"
                                Height="40"
                                Margin="0,0,10,10"
                                ToolTip="Otwórz stronę komputera w TacticalRMM"
                                Click="btnShowInRmm_Click"/>

                        </WrapPanel>
                    </StackPanel>

                    <!-- Result box -->
                    <GroupBox Grid.Row="2"
                              Grid.Column="0"
                              Header="Wynik DHCP"
                              Width="481"
                              Margin="0,0,15,0"
                              HorizontalAlignment="Left">

                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="IP:"
               FontWeight="Bold"
               Grid.Row="0"
               Grid.Column="0"
               Margin="0,0,15,10"/>

                            <TextBlock x:Name="lblIP"
               Text=""
               Grid.Row="0"
               Grid.Column="1"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>

                            <TextBlock Text="MAC:"
               FontWeight="Bold"
               Grid.Row="1"
               Grid.Column="0"
               Margin="0,0,15,10"/>

                            <TextBlock x:Name="lblMAC"
               Text=""
               Grid.Row="1"
               Grid.Column="1"
               Margin="0,0,0,10"
               TextWrapping="Wrap"/>

                            <TextBlock x:Name="lblDnsWarning"
               Grid.Row="2"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               Text=""
                Foreground="DarkOrange"
                FontWeight="Bold"
                TextWrapping="Wrap"
                Visibility="Collapsed"/>

                            <ListBox x:Name="lstResults"
                                     Grid.Row="3"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     Height="70"
                                     Margin="0,5,0,0"/>
                        </Grid>
                    </GroupBox>

                    <!-- History -->
                    <GroupBox Grid.Row="0"
                              Grid.RowSpan="3"
                              Grid.Column="1"
                              Header="Historia"
                              Margin="10,90,0,0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="txtHistoria"
                                     Grid.Row="0"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap"/>

                            <Button x:Name="btnExportHistory"
                                    Grid.Row="1"
                                    Content="Eksportuj historię..."
                                    Height="30"
                                    Margin="0,8,0,0"
                                    Click="btnExportHistory_Click"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- PING TAB -->
            <TabItem x:Name="tabPing" Header="Ping">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="500"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ping hostname row -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">

                        <TextBlock Text="Hostname:"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBox x:Name="txtHostname2"
                                 Width="220"
                                 Height="120"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap"
                                 ToolTip="Jedno lub wiele (przecinki / nowe linie): hostname albo IP. Enter = nowa linia, Ctrl+Enter = start"/>
                    </StackPanel>

                    <GroupBox Grid.Row="0"
                    Grid.Column="1"
                    Header="Dźwięk"
                    Margin="10,0,0,10">

                        <StackPanel Margin="10">

                            <RadioButton x:Name="rbtnSoundOff"
                     Content="Bez dźwięku"
                     IsChecked="True"
                     Margin="0,0,0,6"/>

                            <RadioButton x:Name="rbtnSoundSuccess"
                     Content="Dźwięk przy sukcesie"
                     Margin="0,0,0,6"/>

                            <RadioButton x:Name="rbtnSoundFail"
                     Content="Dźwięk przy błędzie"/>

                        </StackPanel>
                    </GroupBox>

                    <!-- Ping buttons -->
                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="0,20,0,20">

                        <Button x:Name="btnStartPing"
                                Content="Start"
                                Width="83"
                                Height="32"
                                Margin="0,0,10,0"
                                Click="btnStartPing_Click"/>

                        <Button x:Name="btnStopPing"
                                Content="Stop"
                                Width="83"
                                Height="32"
                                Margin="0,0,15,0"
                                Click="btnStopPing_Click"/>

                        <TextBlock Text="Interwał (s):"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>

                        <TextBox x:Name="txtPingInterval"
                                 Text="1"
                                 Width="50"
                                 Height="32"
                                 VerticalContentAlignment="Center"/>

                        <Button x:Name="btnSavePingLog"
                                Content="Zapisz log..."
                                Width="110"
                                Height="32"
                                Margin="10,0,0,0"
                                Click="btnSavePingLog_Click"/>
                    </StackPanel>

                    <!-- Ping status / progress -->
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Orientation="Vertical"
                                Margin="10,20,0,20"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="txtPingStatus"
                                   Text=""
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>

                        <ProgressBar x:Name="progressPing"
                                     Width="160"
                                     Height="18"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"/>
                    </StackPanel>

                  
                    <!-- Ping output -->
                    <GroupBox Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Header="Ping">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="dgPing"
                                      Grid.Row="0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="All"
                                      SelectionMode="Single">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastOk}" Value="True">
                                                <Setter Property="Background" Value="LightGreen"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LastOk}" Value="False">
                                                <Setter Property="Background" Value="LightPink"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Urządzenie" Binding="{Binding Display}" Width="*"/>
                                    <DataGridTextColumn Header="Pinguje" Binding="{Binding StatusText}" Width="70"/>
                                    <DataGridTextColumn Header="Wysłane" Binding="{Binding Sent}" Width="70"/>
                                    <DataGridTextColumn Header="Success" Binding="{Binding Succeeded}" Width="70"/>
                                    <DataGridTextColumn Header="Success %" Binding="{Binding SuccessPctText}" Width="80"/>
                                    <DataGridTextColumn Header="Ost. OK" Binding="{Binding LastOkText}" Width="70"/>
                                    <DataGridTextColumn Header="Ost. TTL" Binding="{Binding LastTtlText}" Width="70"/>
                                    <DataGridTextColumn Header="Śr. TTL" Binding="{Binding AvgTtlText}" Width="70"/>
                                    <DataGridTextColumn Header="Ost. sukces" Binding="{Binding LastSuccessText}" Width="90"/>
                                    <DataGridTextColumn Header="Ost. błąd" Binding="{Binding LastFailText}" Width="90"/>
                                    <DataGridTextColumn Header="Min" Binding="{Binding MinText}" Width="80"/>
                                    <DataGridTextColumn Header="Śr" Binding="{Binding AvgText}" Width="80"/>
                                    <DataGridTextColumn Header="Max" Binding="{Binding MaxText}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="txtPingSummary"
                                       Grid.Row="1"
                                       Margin="0,5,0,0"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas"
                                       FontSize="12"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
            <!-- ACL TAB -->
            <TabItem x:Name="tabACL" Header="ACL" Visibility="Collapsed">
                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- SOURCE -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="IP źródłowe:"
               FontWeight="Bold"
               VerticalAlignment="Center"/>

                        <TextBlock x:Name="lblDhcpStatus"
               Grid.Column="1"
               Margin="10,0,0,0"
               FontWeight="Bold"
               VerticalAlignment="Center"/>
                    </Grid>

                    <TextBox x:Name="txtAclSource"
                 Grid.Row="1"
                 Height="30"
                 Margin="0,5,0,10"/>

                    <TextBlock Text="Osoba (remark):"
                   Grid.Row="2"
                   FontWeight="Bold"/>

                    <TextBox x:Name="txtAclOwner"
                 Grid.Row="3"
                 Height="30"
                 Margin="0,5,0,10"/>

                    <!-- DEST LIST -->
                    <TextBlock Text="Lista IP (ENTER / przecinki):"
                   Grid.Row="4"
                   FontWeight="Bold"/>

                    <TextBox x:Name="txtAclDest"
                 Grid.Row="5"
                 Height="120"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 Margin="0,5,0,10"/>

                    <!-- BUTTON -->
                    <StackPanel Grid.Row="6"
            Orientation="Horizontal"
            Margin="0,5,0,0">

                        <Button x:Name="btnGenerateAcl"
            Content="Generuj ACL"
            Width="160"
            Height="35"
            Margin="0,0,10,0"
            Click="BtnGenerateAcl_Click"/>

                        <Button x:Name="btnCopyAcl"
            Content="Kopiuj do schowka"
            Width="180"
            Height="35"
            Click="BtnCopyAcl_Click"/>

                    </StackPanel>

                    <TextBlock Text="Output Cisco:"
                Grid.Row="7"
                FontWeight="Bold"/>


                    <!-- OUTPUT -->
                    <TextBox x:Name="txtAclOutput"
                 Grid.Row="8"
                 Margin="0,10,0,0"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas"
                 IsReadOnly="True"/>

                </Grid>
            </TabItem>

            <TabItem x:Name="tabSettings" Header="Ustawienia">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Serwer DHCP:"
                               FontWeight="Bold"
                               Grid.Row="0"
                               Margin="0,0,0,5"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBox x:Name="txtDhcpServer"
                                 Width="220"
                                 Height="31"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,10,0"/>
                        <Button x:Name="btnTestDhcp"
                                Content="Sprawdź"
                                Width="120"
                                Height="32"
                                Click="btnTestDhcp_Click"/>
                        <TextBlock x:Name="lblDhcpServerStatus"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Text="TacticalRMM (pulpit bez zabierania sesji):"
                               FontWeight="Bold"
                               Grid.Row="2"
                               Margin="0,15,0,5"/>

                    <StackPanel Grid.Row="3" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="API URL:" Width="90" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtTacticalApiUrl" Width="300" Height="28" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Klucz API:" Width="90" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="txtTacticalApiKey" Width="300" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,0" PasswordChanged="txtTacticalApiKey_PasswordChanged"/>
                            <Button x:Name="btnTestTactical" Content="Testuj" Width="100" Height="28" Click="btnTestTactical_Click"/>
                            <TextBlock x:Name="lblTacticalStatus" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Dashboard:" Width="90" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtTacticalDashboardUrl" Width="300" Height="28" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <CheckBox x:Name="chkTacticalAllowInsecure"
                                  Margin="0,8,0,0"
                                  Content="Zezwól na nieszyfrowane HTTP do API Tactical (klucz API leci wtedy otwartym tekstem)"
                                  ToolTip="Wymagane dla instalacji z API Tactical pod adresem http://. Klucz API jest wtedy przesyłany bez szyfrowania."/>
                    </StackPanel>

                    <TextBlock Text="ACL - podsieci, nazwy i numeracja:"
                               FontWeight="Bold"
                               Grid.Row="4"
                               Margin="0,15,0,5"/>

                    <Grid Grid.Row="5" Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Podsieć 1:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,5"/>
                        <TextBox x:Name="txtAclSubnet1Net" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,5"/>
                        <TextBlock Text="Maska:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,5"/>
                        <TextBox x:Name="txtAclSubnet1Mask" Grid.Row="0" Grid.Column="3" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,5"/>

                        <TextBlock Text="Podsieć 2:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,5"/>
                        <TextBox x:Name="txtAclSubnet2Net" Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,5"/>
                        <TextBlock Text="Maska:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,5"/>
                        <TextBox x:Name="txtAclSubnet2Mask" Grid.Row="1" Grid.Column="3" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,5"/>

                        <TextBlock Text="ACL IN-1:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,5"/>
                        <TextBox x:Name="txtAclIn1" Grid.Row="2" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,5"/>
                        <TextBlock Text="OUT-1:" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,5"/>
                        <TextBox x:Name="txtAclOut1" Grid.Row="2" Grid.Column="3" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,5"/>

                        <TextBlock Text="ACL IN-2:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,5"/>
                        <TextBox x:Name="txtAclIn2" Grid.Row="3" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,5"/>
                        <TextBlock Text="OUT-2:" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,5"/>
                        <TextBox x:Name="txtAclOut2" Grid.Row="3" Grid.Column="3" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,5"/>

                        <TextBlock Text="Seq IN od:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txtAclSeqIn" Grid.Row="4" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Seq OUT od:" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="txtAclSeqOut" Grid.Row="4" Grid.Column="3" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,0"/>
                    </Grid>

                    <Border Grid.Row="7"
                            BorderThickness="1"
                            BorderBrush="#CCCCCC"
                            Padding="10">
                        <StackPanel Orientation="Vertical">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock x:Name="lblAppVersion"
                                           Text="Wersja: ..."
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,15,0"/>
                                <CheckBox x:Name="chkUpdateAuto"
                                          Content="Automatyczne sprawdzanie aktualizacji"
                                          VerticalAlignment="Center"
                                          Margin="0,0,15,0"
                                          Checked="chkUpdateAuto_Checked"
                                          Unchecked="chkUpdateAuto_Unchecked"/>
                                <Button x:Name="btnCheckUpdate"
                                        Content="Sprawdź aktualizacje"
                                        Width="170"
                                        Height="32"
                                        Click="btnCheckUpdate_Click"/>
                                <Button x:Name="btnOpenErrorLog"
                                        Content="Log błędów"
                                        Width="110"
                                        Height="32"
                                        Margin="15,0,0,0"
                                        Click="btnOpenErrorLog_Click"
                                        ToolTip="Otwórz plik z zapisanymi błędami programu."/>
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Format MAC:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0"/>
                                <ComboBox x:Name="cmbMacFormat"
                                          Width="210"
                                          Height="32"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="cmbMacFormat_SelectionChanged">
                                    <ComboBoxItem Content="Zwykły (bez separatorów)"/>
                                    <ComboBoxItem Content="Dwukropki AA:BB:CC:DD:EE:FF"/>
                                    <ComboBoxItem Content="Cisco aabb.ccdd.eeff"/>
                                </ComboBox>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="tabHelp" Header="Instrukcja">
                <Grid Margin="10">
                    <RichTextBox x:Name="rtbManual"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Segoe UI"
                     FontSize="14"
                     Padding="10"
                     BorderThickness="1">

                        <RichTextBox.Document>
                            <StaticResource ResourceKey="InstrukcjaDoc"/>
                        </RichTextBox.Document>
                    </RichTextBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>