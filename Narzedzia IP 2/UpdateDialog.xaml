<Window x:Class="NarzedziaIP.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dostępna aktualizacja"
        Width="560"
        Height="440"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="14">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblTitle"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Text="Dostępna jest nowa wersja"/>

        <TextBox x:Name="txtNotes"
                 Grid.Row="1"
                 Margin="0,10,0,0"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"/>

        <TextBlock x:Name="lblStatus"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   Text=""
                   TextWrapping="Wrap"/>

        <ProgressBar x:Name="progressBar"
                     Grid.Row="3"
                     Height="18"
                     Margin="0,6,0,0"
                     Minimum="0"
                     Maximum="1000"
                     Value="0"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    Margin="0,14,0,0">
            <Button x:Name="btnInstall"
                    Content="Pobierz i zainstaluj"
                    Width="170"
                    Height="34"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="btnInstall_Click"/>
            <Button x:Name="btnSkip"
                    Content="Pomiń tę wersję"
                    Width="140"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="btnSkip_Click"/>
            <Button x:Name="btnLater"
                    Content="Później"
                    Width="100"
                    Height="34"
                    IsCancel="True"
                    Click="btnLater_Click"/>
        </StackPanel>
    </Grid>
</Window>
