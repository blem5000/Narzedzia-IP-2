<Window x:Class="NarzedziaIP.BootUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aktualizacja"
        Width="400"
        Height="150"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="14">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblPhase"
                   Grid.Row="0"
                   Text="Pobieranie aktualizacji..."
                   TextWrapping="Wrap"/>

        <ProgressBar x:Name="progressBar"
                     Grid.Row="1"
                     Height="18"
                     Margin="0,10,0,10"
                     Minimum="0"
                     Maximum="1000"
                     Value="0"/>

        <Button x:Name="btnCancel"
                Grid.Row="2"
                Content="Anuluj"
                Width="100"
                Height="30"
                HorizontalAlignment="Right"
                Click="btnCancel_Click"/>
    </Grid>
</Window>
